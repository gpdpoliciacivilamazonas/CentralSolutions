@{
    ViewData["Title"] = "Início";
}

<section class="hero-card">
    <div class="row align-items-center g-4">
        <div class="col-lg-8">
            <span class="eyebrow">Controle de chamados</span>
            <h1 class="display-5 fw-bold mb-3">Controle de Chamados - GPD</h1>
            <p class="lead mb-4">Registre, acompanhe e resolva chamados por setor em uma interface organizada.</p>
            <a asp-controller="SupportTickets" asp-action="Index" class="btn btn-light btn-lg px-4">Acessar chamados</a>
        </div>
        <div class="col-lg-4">
            <div class="hero-summary-card text-center">
                <img src="~/img/policia_militar.png" alt="Brasão Polícia Civil AM" class="hero-crest" />
                <h2 class="h5 mt-3">Polícia Civil - AM</h2>
                <p class="mb-0">Gestão centralizada de chamados por setor.</p>
            </div>
        </div>
    </div>
</section>
