@model SupportTicket

@{
    ViewData["Title"] = "Editar chamado";
}

<div class="page-heading">
    <div>
        <span class="eyebrow text-primary">Atualização</span>
        <h1>Editar chamado</h1>
        <p>Atualize a situação, responsável, problema ou solução da demanda.</p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="content-card">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="CreatedAt" />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Department" class="form-label"></label>
                        <div class="department-combobox" data-department-combobox>
                            <div class="input-group">
                                <input asp-for="Department" class="form-control" placeholder="Digite para buscar ou selecione o setor" autocomplete="off" data-combobox-input />
                                <button type="button" class="btn btn-outline-secondary" aria-label="Ver setores" data-combobox-toggle>&#9662;</button>
                            </div>
                            <div class="combobox-menu" data-combobox-menu>
                                @foreach (var department in ViewBag.Departments)
                                {
                                    <button type="button" class="combobox-option" data-combobox-option data-value="@department.Value">@department.Text</button>
                                }
                            </div>
                        </div>
                        <span asp-validation-for="Department" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="TicketType" class="form-label"></label>
                        <select asp-for="TicketType" class="form-select" asp-items="ViewBag.TicketTypes">
                            <option value="">Selecione</option>
                        </select>
                        <span asp-validation-for="TicketType" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ResponsibleTechnician" class="form-label"></label>
                        <input asp-for="ResponsibleTechnician" class="form-control" />
                        <span asp-validation-for="ResponsibleTechnician" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ResolutionStatus" class="form-label"></label>
                        <select asp-for="ResolutionStatus" class="form-select" asp-items="ViewBag.Statuses"></select>
                        <span asp-validation-for="ResolutionStatus" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Problem" class="form-label"></label>
                        <textarea asp-for="Problem" class="form-control" rows="4" placeholder="Descreva o problema apresentado"></textarea>
                        <span asp-validation-for="Problem" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Solution" class="form-label"></label>
                        <textarea asp-for="Solution" class="form-control" rows="4" placeholder="Descreva a solução aplicada, se houver"></textarea>
                        <span asp-validation-for="Solution" class="text-danger"></span>
                    </div>
                </div>
                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
                    <button type="submit" class="btn btn-primary px-4">Salvar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
