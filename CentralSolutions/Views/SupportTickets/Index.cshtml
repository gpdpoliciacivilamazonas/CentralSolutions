@model IEnumerable<SupportTicket>

@{
    ViewData["Title"] = "Controle de chamados";
}

<div class="page-heading">
    <div>
        <span class="eyebrow text-primary">GPD</span>
        <h1>Controle de chamados</h1>
        <p>Acompanhe demandas por setor, responsável e situação.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-lg shadow-sm">Novo chamado</a>
</div>

<div class="content-card mb-4">
    <form asp-action="Index" method="get" class="row g-3 align-items-end">
        <div class="col-md-5">
            <label class="form-label" for="department">Setor</label>
            <select id="department" name="department" class="form-select" asp-items="ViewBag.Departments">
                <option value="">Todos</option>
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label" for="status">Resolvido?</label>
            <select id="status" name="status" class="form-select" asp-items="ViewBag.Statuses">
                <option value="">Todos</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-outline-primary flex-fill">Filtrar</button>
            <a asp-action="Index" class="btn btn-outline-secondary flex-fill">Limpar</a>
        </div>
    </form>
</div>

<div class="content-card p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 app-table">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Department)</th>
                    <th>@Html.DisplayNameFor(model => model.TicketType)</th>
                    <th>@Html.DisplayNameFor(model => model.ResponsibleTechnician)</th>
                    <th>@Html.DisplayNameFor(model => model.Resolution)</th>
                    <th>@Html.DisplayNameFor(model => model.ResolutionStatus)</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><strong>@Html.DisplayFor(modelItem => item.Department)</strong></td>
                    <td>@Html.DisplayFor(modelItem => item.TicketType)</td>
                    <td>@(item.ResponsibleTechnician ?? "-")</td>
                    <td class="text-muted">@(item.Resolution ?? "-")</td>
                    <td><span class="status-badge @GetStatusClass(item.ResolutionStatus)">@GetStatusName(item.ResolutionStatus)</span></td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Detalhes</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Excluir</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Nenhum chamado encontrado.</div>
}

@functions {
    private static string GetStatusClass(TicketResolutionStatus status)
    {
        return status switch
        {
            TicketResolutionStatus.Open => "status-open",
            TicketResolutionStatus.No => "status-no",
            TicketResolutionStatus.Yes => "status-yes",
            _ => string.Empty
        };
    }

    private static string GetStatusName(TicketResolutionStatus status)
    {
        return status switch
        {
            TicketResolutionStatus.Open => "Em aberto",
            TicketResolutionStatus.No => "Não",
            TicketResolutionStatus.Yes => "Sim",
            _ => status.ToString()
        };
    }
}
