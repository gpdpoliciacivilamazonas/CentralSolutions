@model SupportTicket

@{
    ViewData["Title"] = $"Chamado #{Model.TicketNumber}";
    ViewData["ExactTitle"] = $"Chamado #{Model.TicketNumber}";
}

<div class="page-heading">
    <div>
        <span class="eyebrow text-danger">Exclusão</span>
        <h1>Excluir Chamado #@Model.TicketNumber</h1>
        <p>Confira os dados antes de remover este registro.</p>
    </div>
</div>

<div class="content-card detail-card border-danger-subtle">
    <div class="alert alert-warning mb-4">
        Confirma a exclusão deste chamado? Esta ação não poderá ser desfeita.
    </div>

    <dl class="row detail-list">
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Department)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.Department)</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.TicketType)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.TicketType)</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.ResponsibleTechnician)</dt>
        <dd class="col-sm-8">@(Model.ResponsibleTechnician ?? "-")</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Problem)</dt>
        <dd class="col-sm-8 text-break">@Model.Problem</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.ResolutionStatus)</dt>
        <dd class="col-sm-8"><span class="status-badge @GetStatusClass(Model.ResolutionStatus)">@GetStatusName(Model.ResolutionStatus)</span></dd>
    </dl>

    <form asp-action="Delete" class="d-flex justify-content-end gap-2 mt-4">
        <input type="hidden" asp-for="Id" />
        <a asp-action="Index" class="btn btn-outline-secondary" onclick="if (window.history.length > 1) { window.history.back(); return false; }">Voltar</a>
        <button type="submit" class="btn btn-danger px-4">Excluir</button>
    </form>
</div>

@functions {
    private static string GetStatusClass(TicketResolutionStatus status)
    {
        return status switch
        {
            TicketResolutionStatus.Open => "status-open",
            TicketResolutionStatus.OnGoing => "status-ongoing",
            TicketResolutionStatus.Done => "status-yes",
            _ => string.Empty
        };
    }

    private static string GetStatusName(TicketResolutionStatus status)
    {
        return status switch
        {
            TicketResolutionStatus.Open => "Em aberto",
            TicketResolutionStatus.OnGoing => "Em andamento",
            TicketResolutionStatus.Done => "Concluído",
            _ => status.ToString()
        };
    }
}
