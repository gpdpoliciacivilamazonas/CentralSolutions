@model SupportTicket
@{
ViewData["Title"] = "Detalhes do chamado";
}
<div class="page-heading">
  <div>
    <span class="eyebrow text-primary">Visualização</span>
    <h1>Detalhes do chamado</h1>
    <p>Consulte os dados registrados para esta demanda.</p>
  </div>
</div>
<div class="content-card detail-card printable-area">
  <div class="d-flex justify-content-between align-items-start gap-3 mb-4">
    <div>
      <span class="eyebrow text-primary">@Html.DisplayFor(model => model.Department)</span>
      <h2 class="h4 mb-1">Chamado #@Model.TicketNumber - @Html.DisplayFor(model => model.TicketType)</h2>
    </div>
    <span class="status-badge @GetStatusClass(Model.ResolutionStatus)">@GetStatusName(Model.ResolutionStatus)</span>
  </div>
  <dl class="row detail-list">
    <dt class="col-sm-4 no-print">@Html.DisplayNameFor(model => model.Id)</dt>
    <dd class="col-sm-8 no-print">#@Model.Id</dd>
    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.ResponsibleTechnician)</dt>
    <dd class="col-sm-8">@(Model.ResponsibleTechnician ?? "-")</dd>
    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Problem)</dt>
    <dd class="col-sm-8">@Model.Problem</dd>
    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Solution)</dt>
    <dd class="col-sm-8">@(Model.Solution ?? "-")</dd>
    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.CreatedAt)</dt>
    <dd class="col-sm-8">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.UpdatedAt)</dt>
    <dd class="col-sm-8">@(Model.UpdatedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "-")</dd>
  </dl>
  <div class="print-footer">
    <img src="~/img/1000261363.jpg" alt="Brasão Polícia Civil AM" class="print-footer-crest" />
    <div class="print-stamp">
      <strong>Recebido e Conferido por Gerência de Processamento de Dados - DAF/PCAM</strong>
      <span>(92) 93667-7780</span>
      <span>gpd@policiacivil.am.gov.br</span>
      <span>Data: <span id="print-date"></span></span>
    </div>
  </div>
  <div class="ticket-actions d-flex justify-content-end gap-2 mt-4 no-print">
    <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
    <button type="button" class="btn btn-outline-primary" onclick="printTicket()" data-print-ticket>Imprimir</button>
    <a href="@Url.Action("Export", "SupportTickets", new { id = Model.Id })" class="btn btn-outline-success"
			download="chamado-@(Model.TicketNumber).csv">Exportar Excel</a>
    <button type="button" class="btn btn-outline-secondary" data-share-ticket>Compartilhar</button>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary px-4">Editar</a>
  </div>
</div>
<div class="toast-container position-fixed bottom-0 end-0 p-3">
  <div class="toast" role="alert" aria-live="assertive" aria-atomic="true" data-share-toast>
    <div class="toast-body">
      Link copiado para a área de transferência.
    </div>
  </div>
</div>
@functions {
private static string GetStatusClass(TicketResolutionStatus status)
{
return status switch
{
TicketResolutionStatus.Open => "status-open",
TicketResolutionStatus.No => "status-no",
TicketResolutionStatus.Yes => "status-yes",
_ => string.Empty
};
}
private static string GetStatusName(TicketResolutionStatus status)
{
return status switch
{
TicketResolutionStatus.Open => "Em aberto",
TicketResolutionStatus.InProgress => "Em andamento",
TicketResolutionStatus.No => "Incompleto",
TicketResolutionStatus.Yes => "Completo",
_ => "Em aberto"
};
}
}
