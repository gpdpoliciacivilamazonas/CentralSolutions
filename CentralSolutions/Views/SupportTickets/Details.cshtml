@model SupportTicket
@{
ViewData["Title"] = $"Chamado #{Model.TicketNumber}";
ViewData["ExactTitle"] = $"Chamado #{Model.TicketNumber}";
ViewData["MetaTitle"] = $"Chamado #{Model.TicketNumber}";
ViewData["MetaDescription"] = $"{Model.Department} - {Model.TicketType}: {Model.Problem}";
ViewData["MetaImage"] = Url.Content("~/img/1000261363.jpg");
}
<div class="page-heading">
  <div>
    <span class="eyebrow text-primary">Visualização</span>
    <h1>Chamado #@Model.TicketNumber</h1>
    <p>Consulte os dados registrados para esta demanda.</p>
  </div>
</div>
<div class="content-card detail-card printable-area">
  <div class="d-flex justify-content-between align-items-start gap-3 mb-4">
    <div>
      <span class="eyebrow text-primary">@Html.DisplayFor(model => model.Department)</span>
      <h2 class="h4 mb-1">Chamado #@Model.TicketNumber - @Html.DisplayFor(model => model.TicketType)</h2>
    </div>
    <span class="status-badge @GetStatusClass(Model.ResolutionStatus)">@GetStatusName(Model.ResolutionStatus)</span>
  </div>
  <dl class="row detail-list">
    <dt class="col-sm-4 no-print">@Html.DisplayNameFor(model => model.Id)</dt>
    <dd class="col-sm-8 no-print">#@Model.Id</dd>
    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.ResponsibleTechnician)</dt>
    <dd class="col-sm-8">@(Model.ResponsibleTechnician ?? "-")</dd>
    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Problem)</dt>
    <dd class="col-sm-8 text-break">@Model.Problem</dd>
    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.CreatedAt)</dt>
    <dd class="col-sm-8">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.UpdatedAt)</dt>
    <dd class="col-sm-8">@(Model.UpdatedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "-")</dd>
  </dl>
  <div class="mt-4 pt-3 border-top">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h3 class="h5 mb-0 fw-bold">Histórico de Atualizações</h3>
      <a asp-action="AddUpdate" asp-route-id="@Model.Id" class="btn btn-sm btn-primary no-print">Nova Atualização</a>
    </div>
    @if (Model.Updates != null && Model.Updates.Any())
    {
    <div class="updates-timeline">
      @foreach (var update in Model.Updates)
      {
      <div class="update-item p-3 mb-2 rounded border bg-light-subtle">
        <div class="d-flex justify-content-between align-items-center mb-1 text-muted small">
          <span><strong>@(update.CreatedBy ?? "Técnico")</strong></span>
          <time class="text-nowrap">@update.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</time>
        </div>
        <p class="mb-0 text-break" style="white-space: pre-wrap;">@update.Description</p>
      </div>
      }
    </div>
    }
    else
    {
    <p class="text-muted fst-italic mb-0">Nenhuma atualização registrada até o momento.</p>
    }
  </div>
  <div class="print-footer">
    <img src="~/img/1000261363.jpg" alt="Brasão Polícia Civil AM" class="print-footer-crest" />
    <div class="print-stamp">
      <strong>Recebido e Conferido por Gerência de Processamento de Dados - DAF/PCAM</strong>
      <span>(92) 93667-7780</span>
      <span>gpd@policiacivil.am.gov.br</span>
      <span>Data: <span id="print-date"></span></span>
    </div>
  </div>
  <div class="ticket-actions d-flex flex-wrap justify-content-end gap-2 mt-4 no-print">
    <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
    <button type="button" class="btn btn-outline-primary" onclick="printTicket()">Imprimir</button>
    <a href="@Url.Action("Export", "SupportTickets", new { ticketNumber = Model.TicketNumber })" class="btn btn-outline-success"
			download="chamado-@(Model.TicketNumber).csv">Exportar Excel</a>
    <button type="button" class="btn btn-outline-secondary" data-share-ticket data-share-url="@Url.Action("ByCode", "SupportTickets", new { code = SupportTicketsController.ToShortSlug(Model.Id) }, Context.Request.Scheme)">Compartilhar</button>
    @if (Model.ResolutionStatus != TicketResolutionStatus.Done)
    {
    <form asp-action="CloseTicket" asp-route-id="@Model.Id" method="post" class="d-inline" onsubmit="return confirm('Deseja realmente concluir este chamado?');">
      <button type="submit" class="btn btn-outline-success">Concluir Chamado</button>
    </form>
    }
    <a asp-action="Edit" asp-route-id="@Model.Id" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)" class="btn btn-outline-primary px-3">Editar</a>
  </div>
</div>
<div class="toast-container position-fixed bottom-0 end-0 p-3">
  <div class="toast" role="alert" aria-live="assertive" aria-atomic="true" data-share-toast>
    <div class="toast-body">
      Link copiado para a área de transferência.
    </div>
  </div>
</div>
@functions {
private static string GetStatusClass(TicketResolutionStatus status)
{
return status switch
{
TicketResolutionStatus.Open => "status-open",
TicketResolutionStatus.OnGoing => "status-ongoing",
TicketResolutionStatus.Done => "status-yes",
_ => string.Empty
};
}
private static string GetStatusName(TicketResolutionStatus status)
{
return status switch
{
TicketResolutionStatus.Open => "Em aberto",
TicketResolutionStatus.OnGoing => "Em andamento",
TicketResolutionStatus.Done => "Concluído",
_ => "Em aberto"
};
}
}
