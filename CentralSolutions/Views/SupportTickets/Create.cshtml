@model SupportTicket

@{
    ViewData["Title"] = "Novo chamado";
}

<div class="page-heading">
    <div>
        <span class="eyebrow text-primary">Cadastro</span>
        <h1>Novo chamado</h1>
        <p>Preencha as informações para registrar uma nova demanda.</p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="content-card">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Department" class="form-label"></label>
                    <select asp-for="Department" class="form-select" asp-items="ViewBag.Departments">
                        <option value="">Selecione</option>
                    </select>
                    <span asp-validation-for="Department" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="TicketType" class="form-label"></label>
                    <select asp-for="TicketType" class="form-select" asp-items="ViewBag.TicketTypes">
                        <option value="">Selecione</option>
                    </select>
                    <span asp-validation-for="TicketType" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ResponsibleTechnician" class="form-label"></label>
                    <input asp-for="ResponsibleTechnician" class="form-control" />
                    <span asp-validation-for="ResponsibleTechnician" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ResolutionStatus" class="form-label"></label>
                    <select asp-for="ResolutionStatus" class="form-select" asp-items="ViewBag.Statuses"></select>
                    <span asp-validation-for="ResolutionStatus" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Resolution" class="form-label"></label>
                    <textarea asp-for="Resolution" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Resolution" class="text-danger"></span>
                </div>
            </div>
            <div class="d-flex justify-content-end gap-2 mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
                <button type="submit" class="btn btn-primary px-4">Salvar</button>
            </div>
        </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
