@model Department

@{
    ViewData["Title"] = "Excluir setor";
}

<div class="page-heading">
    <div>
        <span class="eyebrow text-danger">Exclusão</span>
        <h1>Excluir setor</h1>
        <p>Confira os dados antes de remover este setor.</p>
    </div>
</div>

<div class="content-card detail-card border-danger-subtle">
    <div class="alert alert-warning mb-4">
        Confirma a exclusão deste setor? Chamados existentes manterão o nome do setor salvo no registro.
    </div>

    <dl class="row detail-list">
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Name)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.Name)</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.IsActive)</dt>
        <dd class="col-sm-8">@(Model.IsActive ? "Ativo" : "Inativo")</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.CreatedAt)</dt>
        <dd class="col-sm-8">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
    </dl>

    <form asp-action="Delete" class="d-flex justify-content-end gap-2 mt-4">
        <input type="hidden" asp-for="Id" />
        <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
        <button type="submit" class="btn btn-danger px-4">Excluir</button>
    </form>
</div>
